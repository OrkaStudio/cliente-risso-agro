# Supabase — proyecto risso-agro (ref voippiczkxbxsreiqiqu, región sa-east-1)
# Estos valores son PÚBLICOS (la publishable/anon key viaja al cliente; la protege la RLS).
# El service_role key NUNCA va acá ni en el cliente — solo en Edge Functions / scripts server-side.
# Copiá este archivo a .env.local y completá con los valores reales.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional — satélite de Google (Map Tiles API 2D, 100k tiles/mes gratis).
# Clave restringida por dominio en Google Cloud. Sin ella, el mapa usa Esri.
VITE_GOOGLE_MAPS_KEY=

# Opcional — satélite de MapTiler (Maxar; plan gratis sin tarjeta, 100k/mes).
# Se usa si no hay clave de Google. Sin ninguna, el mapa usa Esri.
VITE_MAPTILER_KEY=

# Opcional — WhatsApp de soporte de Orka (E.164 sin "+": 549 + característica + número).
# Con ella, el asistente ofrece "Hablar con una persona"; sin ella el botón no aparece.
VITE_WHATSAPP_SOPORTE=5492244472369
